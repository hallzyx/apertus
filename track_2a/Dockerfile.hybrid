FROM python:3.11.14-slim-bookworm@sha256:65a93d69fa75478d554f4ad27c85c1e69fa184956261b4301ebaf6dbb0a3543d
WORKDIR /app
COPY requirements-cpu.lock ./
RUN --mount=type=secret,id=cloud_ca \
    if [ -f /run/secrets/cloud_ca ]; then export PIP_CERT=/run/secrets/cloud_ca; fi; \
    pip install --no-cache-dir --no-deps --require-hashes --extra-index-url https://download.pytorch.org/whl/cpu -r requirements-cpu.lock
COPY src ./src
COPY scripts/run_hybrid_workbench.py ./scripts/
COPY deployment ./deployment
COPY data/example-booklet.json ./data/example-booklet.json
COPY tests ./tests
RUN mkdir -p /models && chmod 777 /models
RUN chmod -R a+rX /app/src /app/scripts /app/deployment /app/data /app/tests
ENV PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 APERTUS_REQUIRED_GENERATION=v1.5 EMBEDDING_MODEL_DIR=/models/multilingual-e5-small RETRIEVAL_MODE=hybrid HF_HOME=/models/hf HF_HUB_DISABLE_XET=1 OMP_NUM_THREADS=4 OPENBLAS_NUM_THREADS=4
USER 65534:65534
EXPOSE 8000
VOLUME /models
ENTRYPOINT ["python", "scripts/run_hybrid_workbench.py"]
