# Copy to .env. Leaving this empty allows PDF inspection without classification.
# For our native head backend running on your PC:
# FROZEN_BASE_URL=http://host.docker.internal:8001
# For a remote native backend, use its reachable URL (not a CSCS chat endpoint).
FROZEN_BASE_URL=
APP_PORT=8000
LLM_TIMEOUT_SECONDS=120

# Only if YOUR native backend requires authentication (not the CSCS key).
LLM_API_KEY=
